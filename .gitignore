# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# --- GRADLE ---
.gradle/
build/
# Ignore Gradle GUI config
gradle-app.setting
# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# --- VISUAL STUDIO CODE ---
.vscode/

# --- OTHER IDEs (IntelliJ / Eclipse) ---
# It's good practice to include these in case another team member uses a different IDE
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.factorypath

# --- OS GENERATED FILES ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

bin/
target/
